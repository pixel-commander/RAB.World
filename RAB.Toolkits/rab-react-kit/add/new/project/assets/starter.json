{
  "files": [
    {
      "path": "src/main.tsx",
      "text": "import { createRoot } from 'react-dom/client';\nimport { StyleGuide } from './dashboards/StyleGuide';\nimport './base.css';\n\nconst root = document.getElementById('root');\nif (root) createRoot(root).render(<StyleGuide />);\n"
    },
    {
      "path": "src/base.css",
      "text": "@layer reset, tokens, grid, atoms, components, dashboards, themes, overrides;\n@import './tokens.css' layer(tokens);\n@import './grid.css' layer(grid);\n@import './atoms/container-main.css' layer(atoms);\n@import './atoms/action-main.css' layer(atoms);\n\n@layer reset {\n  * { box-sizing: border-box; }\n  body { margin: 0; font-family: system-ui, sans-serif; }\n  button { font: inherit; }\n}\n@layer dashboards {\n  .style-guide { padding: var(--space-container); gap: var(--space-content); }\n}\n"
    },
    {
      "path": "src/tokens.css",
      "text": ":root {\n  --surface-main: #fff;\n  --surface-inset: #f3f5f8;\n  --content-main: #18222b;\n  --accent-main: #075e69;\n  --content-on-accent: #fff;\n  --space-control: .75rem;\n  --space-content: 1.25rem;\n  --space-container: 2rem;\n  --radius-control: .5rem;\n  --border-control: 1px solid currentColor;\n}\n"
    },
    {
      "path": "src/grid.css",
      "text": "[data-grid] { display: grid; }\n[data-cols='1'] { grid-template-columns: 1fr; }\n[data-rows='1'] { grid-template-rows: 1fr; }\n[data-gap='content'] { gap: var(--space-content); }\n"
    },
    {
      "path": "src/atoms/container-main.css",
      "text": ".container-main {\n  color: var(--container-main-color, var(--content-main));\n  background: var(--container-main-background, var(--surface-main));\n}\n"
    },
    {
      "path": "src/atoms/action-main.css",
      "text": ".action-main {\n  color: var(--action-main-color, var(--content-on-accent));\n  background: var(--action-main-background, var(--accent-main));\n  border: var(--action-main-border, var(--border-control));\n  border-radius: var(--action-main-radius, var(--radius-control));\n}\n.action-main:focus-visible { outline: var(--border-control); outline-offset: .2rem; }\n"
    },
    {
      "path": "src/components/Button/Button.types.ts",
      "text": "import type { ButtonHTMLAttributes } from 'react';\n\nexport type ButtonProps = Omit<ButtonHTMLAttributes<HTMLButtonElement>, 'onClick'> & { handleClick?: ButtonHTMLAttributes<HTMLButtonElement>['onClick'] };\n"
    },
    {
      "path": "src/components/Button/Button.tsx",
      "text": "import type { ButtonProps } from './Button.types';\nimport './css/button.css';\n\nexport const Button = ({ children, handleClick, className = '', type = 'button', ...props }: ButtonProps) => (\n  <button {...props} type={type} className={`button action-main ${className}`.trim()} onClick={handleClick}>\n    {children}\n  </button>\n);\n"
    },
    {
      "path": "src/components/Button/css/button.css",
      "text": "@layer components { .button { padding: var(--space-control) var(--space-content); cursor: pointer; } }\n"
    },
    {
      "path": "src/components/Button/demo/Demo.tsx",
      "text": "import { Button } from '../Button';\n\nexport const Demo = () => <Button>__PROJECT_NAME__ is ready</Button>;\nexport default Demo;\n"
    },
    {
      "path": "src/components/Button/settings.ts",
      "text": "export default { id: 1789380000005, name: 'Button', title: 'Button', description: 'Token-backed example button.', date_added: 1789380000000, indexed: true, options: {} };\n"
    },
    {
      "path": "src/components/Button/README.txt",
      "text": "Button owns its anatomy and spacing. action-main owns its skin.\nThe parent supplies handleClick; this static demo has no action.\n"
    },
    {
      "path": "src/demoRegistry.ts",
      "text": "import type { ComponentType } from 'react';\n\nconst demos = import.meta.glob<{ default: ComponentType }>('./components/**/demo/Demo.tsx', { eager: true });\nconst settings = import.meta.glob<{ default: { indexed?: boolean; title?: string } }>('./components/**/settings.ts', { eager: true });\n\nexport const demoRegistry = Object.entries(demos).flatMap(([path, module]) => {\n  const owner = path.slice(0, -'/demo/Demo.tsx'.length);\n  const metadata = settings[`${owner}/settings.ts`]?.default;\n  return metadata?.indexed ? [{ id: owner, title: metadata.title ?? owner, Demo: module.default }] : [];\n});\n"
    },
    {
      "path": "src/dashboards/StyleGuide.tsx",
      "text": "import { demoRegistry } from '../demoRegistry';\n\nexport const StyleGuide = () => (\n  <main className=\"style-guide container-main\" data-grid data-cols=\"1\" data-gap=\"content\">\n    <h1>__PROJECT_NAME__</h1>\n    {demoRegistry.map(({ id, title, Demo }) => <section key={id}><h2>{title}</h2><Demo /></section>)}\n  </main>\n);\n"
    }
  ],
  "database": [
    {
      "path": "data/app.sqlite",
      "base64": ""
    },
    {
      "path": "data/README.txt",
      "text": "An actual SQLite file with one app_metadata table. No backend or browser adapter is included. Do not serve this folder publicly.\n"
    },
    {
      "path": "scripts/inspect-database.mjs",
      "text": "import { DatabaseSync } from 'node:sqlite';\nimport { fileURLToPath } from 'node:url';\n\nconst database = new DatabaseSync(fileURLToPath(new URL('../data/app.sqlite', import.meta.url)));\nconsole.log(database.prepare('SELECT key, value FROM app_metadata').all());\ndatabase.close();\n"
    }
  ]
}
