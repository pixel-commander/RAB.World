{
  "id": 1789380000002,
  "name": "atom-stamp",
  "title": "Create one background atom",
  "description": "Creates one token-backed background atom. It does not infer appearance from the class name.",
  "date_added": 1789380000000,
  "options": [
    {
      "key": "name",
      "required": true,
      "type": "text",
      "role": "class-name",
      "validate": "css-class",
      "language": {
        "prefixes": [
          "named",
          "called"
        ]
      }
    },
    {
      "key": "layer",
      "required": true,
      "type": "text",
      "role": "css-layer",
      "enum": [
        "atoms"
      ],
      "default": "atoms"
    },
    {
      "key": "token",
      "required": true,
      "type": "text",
      "role": "appearance-background",
      "validate": "css-token",
      "catalog": "tokens",
      "question": "Which registered background token should the new atom use?",
      "language": {
        "prefixes": [
          "using token",
          "with token",
          "token"
        ]
      }
    },
    {
      "key": "theme",
      "required": true,
      "type": "text",
      "enum": [
        "light",
        "dark"
      ]
    },
    {
      "key": "exportTarget",
      "required": true,
      "type": "text",
      "enum": [
        "public",
        "internal"
      ],
      "language": {
        "prefixes": [
          "export target"
        ]
      }
    }
  ]
}
