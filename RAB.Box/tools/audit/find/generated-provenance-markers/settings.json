{
  "id": 1800000000017,
  "name": "generated-provenance-markers",
  "title": "Find Generated Provenance Markers",
  "description": "Finds explicit generated-code provenance comments/markers.",
  "settings": [
    {
      "type": "folder",
      "name": "folder",
      "title": "Folder",
      "description": "Optional folder to scan. Uses the loaded project root when omitted.",
      "required": false
    }
  ],
  "meta": {
    "domain": "audit",
    "operation": "find",
    "target_type": "generated-provenance-markers",
    "output": "report",
    "authority": "read",
    "engine": "line",
    "config": {
      "pattern": "@generated(?:-by)?(?:[-_:a-z0-9]*)",
      "scope": "all",
      "kind": "generated-provenance-marker",
      "heuristic": false,
      "flags": "i"
    }
  }
}
