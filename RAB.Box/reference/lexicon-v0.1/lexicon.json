  "status": "Proposed seed and bounded dry-run demonstration; not a recovered house registry.",
  "scope": "Component-authoring commands, capability questions, and a small statement subset.",
  "normalization": {
    "keywords": "case-insensitive",
    "quoted_values": "preserve exact content and case",
    "unknown": "retain position; return structured failure; never delete",
    "bare_names": "not supported in demo; quote name/class values",
    "incomplete_or_ambiguous": "no execution"
  },
  "entry_contract": {
    "id": "stable semantic ID",
    "forms": "explicit spellings; no fuzzy match",
    "family": "job/category",
    "accepts": "conceptual argument types, not an executable type checker",
    "returns": "conceptual result type",
    "meaning": "local interpretation contract",
    "support": "demo = used by one or more declared grammar rules; reserved = dictionary seed only, not implemented"
  },
